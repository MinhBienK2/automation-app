{
  "projectId": "05d49836-f888-4e5a-bd4e-24f217bb13df",
  "shape": "package",
  "pkg": "automation-app-ui",
  "globalName": "AutomationUI",
  "buildCmd": "node .design-sync/build-ds-pkg.mjs",
  "readmeHeader": ".design-sync/conventions.md",
  "srcDir": "src",
  "cssEntry": "styles.css",
  "extraFonts": ["../.design-sync/fonts/fonts.css"],
  "extraEntries": ["./preview-root.tsx"],
  "provider": { "component": "DSPreviewRoot" },
  "overrides": {
    "DataTable": { "cardMode": "column" },
    "Table": { "cardMode": "column" },
    "SortableTableHead": { "cardMode": "column" },
    "Tooltip": { "cardMode": "column" },
    "ToastProvider": { "cardMode": "single", "primaryStory": "RaisedNotifications" },
    "Dialog": { "cardMode": "single" },
    "ConfirmDialog": { "cardMode": "single" },
    "UnsavedChangesDialog": { "cardMode": "single" }
  },
  "componentSrcMap": {
    "CardContent": "src/data-display/card.tsx",
    "CardHeader": "src/data-display/card.tsx",
    "CardTitle": "src/data-display/card.tsx",
    "TableHeader": "src/data-display/table.tsx",
    "TableBody": "src/data-display/table.tsx",
    "TableRow": "src/data-display/table.tsx",
    "TableHead": "src/data-display/table.tsx",
    "TableCell": "src/data-display/table.tsx",
    "SortableTableHead": "src/data-display/table.tsx",
    "CheckboxField": "src/forms/checkbox.tsx",
    "SwitchField": "src/forms/switch.tsx",
    "DialogContent": "src/overlays/dialog.tsx",
    "DialogDescription": "src/overlays/dialog.tsx",
    "DialogFooter": "src/overlays/dialog.tsx",
    "DialogHeader": "src/overlays/dialog.tsx",
    "DialogTitle": "src/overlays/dialog.tsx",
    "DialogTrigger": "src/overlays/dialog.tsx",
    "DropdownMenuTrigger": "src/overlays/dropdown-menu.tsx",
    "DropdownMenuContent": "src/overlays/dropdown-menu.tsx",
    "DropdownMenuItem": "src/overlays/dropdown-menu.tsx",
    "DropdownMenuSeparator": "src/overlays/dropdown-menu.tsx",
    "DropdownMenuLabel": "src/overlays/dropdown-menu.tsx",
    "DropdownMenuPortal": "src/overlays/dropdown-menu.tsx",
    "TooltipContent": "src/feedback/tooltip.tsx",
    "TooltipProvider": "src/feedback/tooltip.tsx",
    "TooltipTrigger": "src/feedback/tooltip.tsx",
    "ToastProvider": "src/feedback/toast.tsx"
  }
}
