{
  "name": "workflow-automation-manager",
  "private": true,
  "version": "0.1.5",
  "description": "Electron desktop app for authorized internal browser automation workflows.",
  "author": "Internal Automation Lab <automation-lab@example.invalid>",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/dev/electron-dev.mjs",
    "electron:pack": "npm run electron:pack:linux",
    "electron:pack:dir": "npm run build && electron-builder --linux dir --publish never",
    "electron:pack:linux": "npm run build && electron-builder --linux AppImage deb tar.gz --publish never",
    "electron:pack:win": "npm run build && electron-builder --win nsis zip --publish never",
    "electron:pack:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "cloakbrowser:fonts:setup": "node scripts/dev/setup-cloakbrowser-fonts.mjs",
    "deploy": "node scripts/deploy/deploy-release.mjs",
    "release:sbom": "node scripts/deploy/generate-release-sbom.mjs release/sbom.cyclonedx.json",
    "release:manifest": "node scripts/deploy/generate-release-manifest.mjs release",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:full",
    "test:e2e:smoke": "npm run build:electron && playwright test tests/e2e/electron-isolation.e2e.ts tests/e2e/core-execution.e2e.ts tests/e2e/workflow-user-journeys.e2e.ts tests/e2e/coverage-matrix.e2e.ts tests/e2e/browser-recorder.e2e.ts",
    "test:e2e:full": "npm run build:electron && playwright test",
    "test:e2e:visible": "npm run build:electron && E2E_VISIBLE_BROWSER=1 playwright test --headed tests/e2e/browser-context-storage.e2e.ts tests/e2e/capture-network.e2e.ts tests/e2e/core-execution.e2e.ts tests/e2e/extended-form-actions.e2e.ts tests/e2e/human-behavior.e2e.ts tests/e2e/keyboard-dialog.e2e.ts tests/e2e/navigation-actions.e2e.ts tests/e2e/pointer-actions.e2e.ts tests/e2e/wait-assertion-actions.e2e.ts",
    "test:e2e:flake": "npm run build:electron && playwright test tests/e2e/pointer-actions.e2e.ts tests/e2e/human-behavior.e2e.ts tests/e2e/core-execution.e2e.ts tests/e2e/extended-form-actions.e2e.ts tests/e2e/keyboard-dialog.e2e.ts --repeat-each=5",
    "test:e2e:real-web": "npm run build:electron && E2E_REAL_WEB=1 playwright test tests/e2e/real-world-web.e2e.ts",
    "test:fingerprint": "vitest run electron/backend/browser/sessionManager.test.ts electron/backend/runtime/runner.test.ts",
    "test:smoke": "RUN_CLOAKBROWSER_SMOKE=1 vitest run electron/backend/runtime/runner.smoke.test.ts",
    "lint": "eslint src/ electron/ --max-warnings=0",
    "lint:fix": "eslint src/ electron/ --fix",
    "agent:validate-routes": "node scripts/agent/validate-routes.mjs",
    "db:migrate": "npm run build:electron && node scripts/db-migrate.mjs",
    "db:migrate-graphs": "npm run build:electron && node scripts/db-migrate-graphs.mjs",
    "db:rollback": "npm run build:electron && node scripts/db-rollback.mjs",
    "db:seed": "npm run build:electron && node scripts/db-seed.mjs",
    "db:migrate-mongo:create": "npx migrate-mongo create",
    "db:migrate-mongo:up": "npx migrate-mongo up",
    "db:migrate-mongo:down": "npx migrate-mongo down",
    "db:migrate-mongo:status": "npx migrate-mongo status",
    "preview": "vite preview"
  },
  "build": {
    "appId": "internal.automation.workflow-manager",
    "productName": "Automation App",
    "publish": {
      "provider": "github",
      "owner": "MinhBienK2",
      "repo": "tik-automation"
    },
    "icon": "public/app-logo.png",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "migrations/**/*",
      "migrations-mongo/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.21.0",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "cloakbrowser": "0.4.3",
    "daisyui": "^5.7.16",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.12.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mmdb-lib": "3.0.3",
    "mongodb": "^7.5.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.0.2",
    "migrate-mongo": "^14.0.7",
    "node-pg-migrate": "^8.0.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
